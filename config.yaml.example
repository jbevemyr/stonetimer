#
# StoneTimer configuration (example)
#
# device_id:
# - tee       (Pi Zero @ tee/back line)
# - hog_close (Pi 4 @ near hog)
# - hog_far   (Pi Zero @ far hog)
device_id: "tee"

gpio:
  # LM393 digital output pin (default wiring uses GPIO17 / physical pin 11)
  sensor_pin: 17
  # Debounce in ms (increase if you get double triggers)
  debounce_ms: 50
  # Pi 4 only: IR arm sensor pin (GPIO27 / physical pin 13)
  # arm_pin: 27

server:
  # Pi 4 IP/hostname (default if using setup_network.sh AP)
  host: "192.168.50.1"
  # UDP triggers (sensors -> server)
  port: 5000
  # Web UI (Pi 4 only)
  http_port: 8080
  # Server listen UDP (Pi 4 only; should match port)
  udp_port: 5000

  # Speech (Pi 4 only)
  enable_speech: true
  # ALSA output (optional).
  # Prefer named devices (stable across reboots): "default:CARD=Headphones"
  # You can list devices with: aplay -L
  alsa_device: "default:CARD=Headphones"
  # Start ARMED at boot (Pi 4 only)
  auto_arm_on_start: true
  # Auto-rearm back to ARMED if we get stuck in MEASURING after the first trigger.
  # Useful if a run is aborted / sensor missed and the UI would otherwise stay "measuring".
  auto_rearm:
    enabled: false
    after_s: 120
  speech:
    speak_ready: true
    speak_tee_hog: true
    speak_hog_hog: true

  # Debug: log TTS spawns (optional)
  # tts_debug_log: "/var/log/stonetimer-tts-spawn.log"

  # Optional/advanced:
  #
  # Sensors (Pi Zero): each trigger is sent this many times in total, since a single
  # UDP datagram can get lost on Wi-Fi. The server drops the duplicates.
  # trigger_repeats: 3
  # trigger_repeat_interval_ms: 20
  # heartbeat_interval_s: 5
  #
  # Server (Pi 4):
  # A sensor is shown as offline when nothing was heard from it for this long.
  # sensor_timeout_s: 12
  # A sensor is flagged (orange dot) when its clock appears to differ from the
  # server's by more than this. Times involving that sensor are then unreliable.
  # clock_skew_warn_ms: 25
  # Number of measurements kept in the history.
  # max_history: 100
  # Where history.json and runtime_settings.json are stored (default: install dir).
  # data_dir: "/opt/stonetimer"
